---
---

<section class="auth-view" id="viewAuth">
  <div class="auth-bg"></div>
  <div class="auth-overlay"></div>
  <div class="auth-card">
    <div class="auth-logo">LASHTRIBE <em>Academy</em></div>
    <div class="auth-tabs">
      <button class="auth-tab active" data-tab="signin">Sign In</button>
      <button class="auth-tab" data-tab="create">Create Account</button>
    </div>

    <div class="auth-panel active" id="panelSignin">
      <div class="field">
        <label>Email</label>
        <input type="email" id="siEmail" value="amina@lashtribe.africa" />
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" id="siPass" value="demo1234" />
      </div>
      <button class="btn-primary auth-submit" id="signinBtn">Sign In</button>
      <p class="auth-switch">
        New here? <a href="#" data-switch="create">Create an account</a>
      </p>
    </div>

    <div class="auth-panel" id="panelCreate">
      <div class="field">
        <label>Full Name</label>
        <input type="text" id="crName" placeholder="e.g. Wanjiru Kamau" />
      </div>
      <div class="field">
        <label>Email</label>
        <input type="email" placeholder="you@example.com" />
      </div>
      <div class="field">
        <label>Password</label>
        <input type="password" placeholder="Create a password" />
      </div>
      <button class="btn-primary auth-submit" id="createBtn">Create Account</button>
      <p class="auth-switch">
        Already learning with us? <a href="#" data-switch="signin">Sign in</a>
      </p>
    </div>
  </div>
</section>
