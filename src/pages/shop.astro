---
import Layout from "../layouts/ecommerce/Layout.astro";
import SiteHeader from "../components/ecommerce/SiteHeader.astro";
import ProductRail from "../components/ecommerce/ProductRail.astro";
import SiteFooter from "../components/ecommerce/SiteFooter.astro";
import CartDrawer from "../components/ecommerce/CartDrawer.astro";
import { getEcommerceProducts } from "../data/ecommerce-products.js";

type Product = {
  slug: string;
  name: string;
  description?: string;
  note?: string;
  marketPrice?: number;
  nowPrice?: number;
  effectivePrice?: number;
  hasOffer?: boolean;
  offerBadge?: string;
  moq?: number;
  images?: { url?: string }[];
  category?: { name?: string; slug?: string } | null;
};

const allProducts = (await getEcommerceProducts()) as Product[];

const slugify = (value = "") =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const groupedProducts = Object.entries(
  allProducts.reduce<Record<string, Product[]>>((acc, product) => {
    const category = product.category?.name || "Other";
    if (!acc[category]) acc[category] = [];
    acc[category].push(product);
    return acc;
  }, {})
) as [string, Product[]][];
groupedProducts.sort(([left], [right]) => left.localeCompare(right));

function toSearchCard(product: Product) {
  const category = product.category?.name || "Other";
  return {
    slug: product.slug,
    image: product.images?.[0]?.url,
    name: product.name,
    marketPrice: `Ksh ${Number(product.marketPrice || 0).toLocaleString()}`,
    nowPrice: `Ksh ${Number(product.effectivePrice ?? product.nowPrice ?? 0).toLocaleString()}`,
    hasOffer: product.hasOffer,
    offerPrice: `Ksh ${Number(product.effectivePrice ?? 0).toLocaleString()}`,
    offerBadge: product.offerBadge,
    note: product.note || "",
    moq: product.moq,
    searchText: [product.name, product.slug, product.description, product.note, category].filter(Boolean).join(" "),
  };
}
---

<Layout title="Shop | Lashtribe Africa">
  <SiteHeader />

  <nav class="shop-chips" id="shopChips" aria-label="Product categories">
    {groupedProducts.map(([category]) => (
      <a href={`#${slugify(category)}`} data-chip-target={slugify(category)}>{category}</a>
    ))}
  </nav>

  <main class="shop-page">
    <div id="fullCatalog">
      {groupedProducts.map(([category, products], index) => (
        <ProductRail
          id={slugify(category)}
          title={category}
          products={products.map(toSearchCard)}
          viewAllHref="/shop"
          showViewAll={false}
          noTopPadding={index === 0}
        />
      ))}
    </div>

    <div id="searchResults" hidden>
      <ProductRail
        id="search-results"
        title="Search Results"
        products={allProducts.map(toSearchCard)}
        viewAllHref="/shop"
        showViewAll={false}
      />
      <p class="shop wrap search-no-results" id="searchNoResults" hidden>No products found.</p>
    </div>
  </main>

  <SiteFooter />
  <CartDrawer />
  <script src="/scripts/shared-cart.js" is:inline></script>
  <script src="/scripts/cart-render.js" is:inline></script>
  <script src="/scripts/main.js" is:inline></script>
  <script>
    const searchParams = new URLSearchParams(window.location.search);
    const searchQuery = searchParams.get("search")?.trim() || "";
    const searchInput = document.querySelector<HTMLInputElement>("#searchInput");
    const fullCatalog = document.querySelector<HTMLElement>("#fullCatalog");
    const searchResults = document.querySelector<HTMLElement>("#searchResults");
    const searchNoResults = document.querySelector<HTMLElement>("#searchNoResults");
    const searchTerms = searchQuery.toLocaleLowerCase().split(/\s+/).filter(Boolean);

    if (searchInput instanceof HTMLInputElement) searchInput.value = searchQuery;

    if (searchQuery && fullCatalog && searchResults) {
      fullCatalog.hidden = true;
      searchResults.hidden = false;
      let matchingProducts = 0;

      searchResults.querySelectorAll<HTMLElement>("[data-product-search]").forEach((card) => {
        const productText = (card.getAttribute("data-product-search") || "").toLocaleLowerCase();
        const matches = searchTerms.every((term) => productText.includes(term));
        card.hidden = !matches;
        card.style.display = matches ? "" : "none";

        if (matches) {
          matchingProducts += 1;
          card.classList.add("in-view");
        }
      });

      if (searchNoResults) searchNoResults.hidden = matchingProducts > 0;
    }

    // Mobile category chips: highlight the category currently in view.
    const chipBar = document.querySelector<HTMLElement>("#shopChips");
    if (chipBar && "IntersectionObserver" in window) {
      const chips = Array.from(chipBar.querySelectorAll<HTMLAnchorElement>("a[data-chip-target]"));
      const setActive = (id: string) => {
        chips.forEach((chip) => {
          const on = chip.dataset.chipTarget === id;
          chip.classList.toggle("active", on);
          if (on) {
            const left = chip.offsetLeft - (chipBar.clientWidth - chip.offsetWidth) / 2;
            chipBar.scrollTo({ left, behavior: "smooth" });
          }
        });
      };
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (visible.length) setActive((visible[0].target as HTMLElement).id);
        },
        { rootMargin: "-120px 0px -60% 0px", threshold: 0 }
      );
      chips.forEach((chip) => {
        const section = document.getElementById(chip.dataset.chipTarget || "");
        if (section) observer.observe(section);
      });
      if (chips[0]) chips[0].classList.add("active");
    }
  </script>
</Layout>
