---
import Layout from "../../../layouts/ecommerce/Layout.astro";
import SiteHeader from "../../../components/ecommerce/SiteHeader.astro";
import CartDrawer from "../../../components/ecommerce/CartDrawer.astro";
import SiteFooter from "../../../components/ecommerce/SiteFooter.astro";
import Breadcrumbs from "../../../components/ecommerce/Breadcrumbs.astro";
import { getEcommerceProducts, formatKsh, cardPrices } from "../../../data/ecommerce-products.js";
import ProductCard from "../../../components/ecommerce/ProductCard.astro";
import { linePrices, previewDelta, optionDisplayType, swatchColor } from "../../../lib/pricing.js";

export async function getStaticPaths() {
  const products = await getEcommerceProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const slugify = (value = "") =>
  value
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const allProducts = await getEcommerceProducts();
const slug = Astro.params.slug || allProducts[0].slug;
const product = allProducts.find((p) => p.slug === slug) || allProducts[0];
const complementaryProducts = allProducts.filter((item) =>
  product.complementSlugs.includes(item.slug)
);

// "You may also like": the same category first, then anything else, three in total.
const sameCategory = allProducts.filter(
  (item) => item.slug !== product.slug && product.category && item.category?.id === product.category.id
);
const sameIds = new Set(sameCategory.map((item) => item.id));
const otherProducts = allProducts.filter((item) => item.slug !== product.slug && !sameIds.has(item.id));
const relatedProducts = [...sameCategory, ...otherProducts].slice(0, 4).map((item) => ({
  id: item.id,
  slug: item.slug,
  icon: item.icon,
  image: item.images?.[0]?.url,
  name: item.name,
  description: item.description || "",
  ...cardPrices(item),
  hasOptions: Boolean(item.hasOptions),
  hasOffer: item.hasOffer,
  offerBadge: item.offerBadge,
  campaignBadge: item.campaignBadge,
  dealNotes: item.dealNotes,
  moq: item.moq,
}));

const coverImage = product.images?.[0];

const crumbs = [
  { label: "Home", href: "/ecommerce" },
  { label: "Shop", href: "/shop" },
  // main category, then subcategory (0025); the shop page anchors are the category slugs
  ...(product.category?.parent
    ? [{ label: product.category.parent.name, href: `/shop#${product.category.parent.slug || slugify(product.category.parent.name)}` }]
    : []),
  ...(product.category ? [{ label: product.category.name, href: `/shop#${product.category.slug || slugify(product.category.name)}` }] : []),
  { label: product.name },
];

// What the page needs to price a quantity / option choice in the browser (mirrors the database rules).
const config = {
  id: product.id,
  name: product.name,
  moq: product.moq,
  marketPrice: product.marketPrice,
  nowPrice: product.nowPrice,
  retailPrice: product.retailPrice,
  offerPct: product.offerPct || 0,
  options: product.options,
};
const configJson = JSON.stringify(config).replace(/</g, "\\u003c");

// First paint: wholesale price at the MOQ, options not chosen yet counted at their cheapest value.
const start = linePrices(config, {}, product.moq, { preview: true });
const startPartial = previewDelta(product.options, {}).partial;
const startSave = start.market > start.unit ? start.market - start.unit : 0;
const deltaLabel = (d) => `${d > 0 ? "+" : "−"}${formatKsh(Math.abs(d))}`;
---

<Layout title={`${product.name} | Lashtribe Africa`}>
  <SiteHeader />

  <Breadcrumbs items={crumbs} />

  <main class="product-page">
    <section class="product-shell wrap">
      <div class="product-gallery">
        <div class:list={["product-visual", product.images.length > 0 && "has-gallery"]} id="productVisual">
          <span class="product-badge">{product.badge}</span>
          {product.campaignBadge && <span class="badge-deal badge-deal-lg">{product.campaignBadge}</span>}
          {product.hasOffer && <span class:list={["offer-badge", product.campaignBadge && "below-deal"]}>{product.offerBadge}</span>}
          {product.images.length > 0 ? (
            <div class="gallery-track" id="galleryTrack" tabindex="0" aria-label="Product photos">
              {product.images.map((img, i) => (
                <div class="gallery-slide" data-image-url={img.url}>
                  <img
                    src={img.url}
                    alt={img.alt || product.name}
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                    draggable="false"
                  />
                </div>
              ))}
            </div>
          ) : (
            <svg viewBox="0 0 100 100" set:html={product.icon} />
          )}
        </div>

        {product.images.length > 1 && (
          <div class="product-thumb-strip" id="thumbStrip">
            {product.images.map((img, i) => (
              <button type="button" class:list={["thumb-btn", i === 0 && "active"]} data-image-url={img.url} data-index={i} aria-label={`Show photo ${i + 1}`}>
                <img src={img.url} alt="" loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        )}

        {product.videos.length > 0 && (
          <div class="product-video-block">
            <h3>Product Demo</h3>
            <video src={product.videos[0].url} controls preload="metadata" />
          </div>
        )}

        {complementaryProducts.length > 0 && (
          <div class="bundle-strip" aria-label="Goes together with">
            <div class="bundle-header">
              <span class="eyebrow">Goes together with</span>
            </div>
            <div class="bundle-items">
              {
                complementaryProducts.map((item) => (
                  <div class="bundle-card">
                    <div class="bundle-thumb">
                      {item.images?.[0] ? (
                        <img src={item.images[0].url} alt={item.name} loading="lazy" decoding="async" />
                      ) : (
                        <svg viewBox="0 0 100 100" set:html={item.icon} />
                      )}
                    </div>
                    <div class="bundle-copy">
                      <strong>{item.name}</strong>
                      <span>{item.priceVaries ? "From " : ""}{formatKsh(item.effectiveFromPrice ?? item.effectivePrice)}</span>
                    </div>
                    {item.hasOptions ? (
                      <a class="bundle-add bundle-choose" href={`/ecommerce/product/${item.slug}`} aria-label={`Choose options for ${item.name}`}>
                        ›
                      </a>
                    ) : (
                      <button
                        class="bundle-add"
                        type="button"
                        data-product-id={item.id}
                        data-moq={item.moq}
                        aria-label={`Add ${item.name} to cart`}
                      >
                        +
                      </button>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        )}
      </div>

      <div class="product-panel" data-product-id={product.id}>
        <div class="product-meta">
          <span class="eyebrow">
            {product.category ? product.category.name : "Wholesale favorite"}
          </span>
        </div>

        <h1>{product.name}</h1>

        {product.features.length > 0 && (
          <ul class="feature-list">
            {product.features.map((feature) => <li>{feature}</li>)}
          </ul>
        )}

        <div class="product-price-card" id="priceCard">
          <div class="market-price-row" id="marketRow" hidden={start.market <= start.unit}>
            <span class="label">Market Price</span>
            <span class="market-price" id="marketPrice">{formatKsh(start.market)}</span>
          </div>
          <div class="save-row" id="saveRow" hidden={startSave <= 0}>
            <span class="label">You Will Save</span>
            <strong id="saveAmount">{formatKsh(startSave)}</strong>
          </div>
          <div class="offer-price-row" id="offerRow" hidden={!(product.offerPct > 0)}>
            <span class="offer-badge-inline">{product.offerBadge}</span>
            <span class="was-price" id="wasPrice">{formatKsh(start.list)}</span>
          </div>
          <div class="current-price-row">
            <span class="tier-badge tier-wholesale" id="tierBadge">Wholesale price</span>
            <span class="current-price" id="currentPrice">{startPartial ? "From " : ""}{formatKsh(start.unit)}</span>
            <span class="price-sub" id="priceSub">per unit</span>
          </div>
          <p class="tier-hint" id="tierHint"></p>
          {product.dealNotes?.length > 0 && (
            <p class="deal-notes deal-notes-lg">{product.dealNotes.map((note) => <span>{note}</span>)}</p>
          )}
        </div>

        <p class="tier-hint" id="minNote" hidden></p>

        <div class="qty-row">
          <span class="label">Quantity</span>
          <div class="qty-counter">
            <button type="button" id="qtyMinus" aria-label="Decrease quantity">−</button>
            <input type="number" id="qtyInput" min="1" max="100000" step="1" value={product.moq} inputmode="numeric" aria-label="Quantity" />
            <button type="button" id="qtyPlus" aria-label="Increase quantity">+</button>
          </div>
        </div>

        {product.options.length > 0 && (
          <div class="option-groups" id="optionGroups">
            {product.options.map((option) => {
              const kind = optionDisplayType(option);
              return (
                <div class="option-group" data-option-group={option.name} data-kind={kind}>
                  <div class="option-label">
                    <span>{option.name}</span>
                    <em class="option-chosen" data-chosen-for={option.name}>Select</em>
                  </div>
                  <div class={`option-values option-values-${kind}`} role="radiogroup" aria-label={option.name}>
                    {option.values.map((v) => {
                      const title = v.priceDelta !== 0 ? `${v.value} (${deltaLabel(v.priceDelta)})` : v.value;
                      const common = {
                        type: "button",
                        role: "radio",
                        "aria-checked": "false",
                        "data-option": option.name,
                        "data-value": v.value,
                        "data-image": v.image || undefined,
                        title,
                      };
                      if (kind === "color") {
                        const color = swatchColor(v);
                        return (
                          <button {...common} class="opt-swatch" aria-label={title} style={color ? `--swatch:${color}` : undefined}>
                            <span class="opt-swatch-dot" />
                          </button>
                        );
                      }
                      if (kind === "image") {
                        return (
                          <button {...common} class="opt-tile" aria-label={title}>
                            {v.image ? <img src={v.image} alt="" loading="lazy" decoding="async" /> : <span class="opt-tile-blank" />}
                            <span class="opt-tile-name">{v.value}</span>
                            {v.priceDelta !== 0 && <small>{deltaLabel(v.priceDelta)}</small>}
                          </button>
                        );
                      }
                      return (
                        <button {...common} class="opt-pill">
                          {v.value}
                          {v.priceDelta !== 0 && <small>{deltaLabel(v.priceDelta)}</small>}
                        </button>
                      );
                    })}
                  </div>
                </div>
              );
            })}
            <p class="option-msg" id="optionMsg" role="alert" hidden></p>
          </div>
        )}

        <div class="product-actions">
          <button class="btn-primary product-add" type="button" id="addToCart">
            Add to Cart
          </button>
          <button class="btn-black product-buy" type="button" id="buyNow">
            Buy Now
          </button>
        </div>

        <div class="product-description">
          <h2>Product Details</h2>
          <p>{product.description}</p>
          <p>
            Preorder from Lashtribe Africa and receive direct sourcing value on every order,
            with flexible batch volumes and fast dispatch on the next available production run.
          </p>
        </div>
      </div>
    </section>

    <section class="related-products wrap">
      <div class="section-head related-head">
        <h2>You may also like</h2>
      </div>
      <div class="related-grid">
        {
          relatedProducts.map((item) => <ProductCard product={item} reveal={false} />)
        }
      </div>
    </section>
  </main>

  <SiteFooter />
  <CartDrawer />

  <script type="application/json" id="product-config" set:html={configJson} />

  <script src="/scripts/shared-cart.js" is:inline></script>
  <script src="/scripts/cart-render.js" is:inline></script>
  <script src="/scripts/main.js" is:inline></script>
  <script>
    import { linePrices, previewDelta, resolveOptions, formatKsh } from "../../../lib/pricing.js";

    const cart = () => (window as any).LashtribeCart;
    const config = JSON.parse(document.getElementById("product-config")?.textContent || "{}");
    const selected: Record<string, string> = {};

    const $ = (id: string) => document.getElementById(id);
    const qtyInput = $("qtyInput") as HTMLInputElement | null;
    const minNote = $("minNote");
    let minQty = 1; // what this shipment still needs of this product (the live MOQ), 1 = nothing
    const addButton = $("addToCart") as HTMLButtonElement | null;
    const optionMsg = $("optionMsg");

    const show = (id: string, on: boolean) => {
      const node = $(id);
      if (node) node.hidden = !on;
    };
    const text = (id: string, value: string) => {
      const node = $(id);
      if (node) node.textContent = value;
    };

    // The quantity as a number >= 1 (while someone is typing a box can be empty; that counts as 1 for display)
    function quantity() {
      const n = Math.round(Number(qtyInput?.value));
      return Number.isFinite(n) && n >= 1 ? Math.min(100000, n) : 1;
    }

    // the quantity to add to the cart: never below the live minimum
    function orderQuantity() {
      return Math.max(quantity(), minQty);
    }

    function update() {
      const qty = quantity();
      const { complete, missing } = resolveOptions(config.options, selected);
      const { partial } = previewDelta(config.options, selected);
      const p = linePrices(config, selected, qty, { preview: true });
      const save = p.market > p.unit ? p.market - p.unit : 0;
      const wholesaleCheaper = p.wholesale < p.retail;

      text("currentPrice", `${partial ? "From " : ""}${formatKsh(p.unit)}`);
      text("priceSub", partial ? "per unit · pick every option for your exact price" : `per unit · ${formatKsh(p.unit * qty)} for ${qty}`);

      const badge = $("tierBadge");
      if (badge) {
        badge.textContent = p.tier === "wholesale" ? "Wholesale price" : "Retail price · below minimum";
        badge.classList.toggle("tier-wholesale", p.tier === "wholesale");
        badge.classList.toggle("tier-retail", p.tier !== "wholesale");
      }

      if (minNote) {
        minNote.textContent = qty < minQty ? `Minimum order: ${minQty}. Quantity set to ${minQty} when you add it.` : "";
        minNote.hidden = !minNote.textContent;
      }

      if (p.tier === "retail" && wholesaleCheaper) {
        text("tierHint", `Order ${config.moq} or more to get the wholesale price of ${formatKsh(p.wholesale)} each (save ${formatKsh(p.retail - p.wholesale)} per unit).`);
      } else {
        text("tierHint", "");
      }
      show("tierHint", Boolean($("tierHint")?.textContent));

      show("marketRow", save > 0);
      show("saveRow", save > 0);
      text("marketPrice", formatKsh(p.market));
      text("saveAmount", formatKsh(save));
      show("offerRow", Number(config.offerPct) > 0);
      text("wasPrice", formatKsh(p.list));

      if (addButton) addButton.textContent = complete ? "Add to Cart" : `Choose ${missing[0]}`;
    }

    // ---- options ----
    document.querySelectorAll<HTMLButtonElement>("[data-option][data-value]").forEach((pill) => {
      pill.addEventListener("click", () => {
        const name = pill.dataset.option || "";
        selected[name] = pill.dataset.value || "";
        document.querySelectorAll<HTMLButtonElement>("[data-option][data-value]").forEach((other) => {
          if (other.dataset.option !== name) return;
          const on = other === pill;
          other.classList.toggle("is-selected", on);
          other.setAttribute("aria-checked", String(on));
        });
        const chosen = document.querySelector(`[data-chosen-for="${CSS.escape(name)}"]`);
        if (chosen) chosen.textContent = selected[name];
        document.querySelector(`[data-option-group="${CSS.escape(name)}"]`)?.classList.remove("option-missing");
        if (optionMsg) optionMsg.hidden = true;
        showVariantImage(pill.dataset.image);
        update();
      });
    });

    // ---- quantity ----
    qtyInput?.addEventListener("input", update);
    qtyInput?.addEventListener("change", () => {
      qtyInput.value = String(quantity());
      update();
    });
    $("qtyMinus")?.addEventListener("click", () => {
      if (qtyInput) qtyInput.value = String(Math.max(1, quantity() - 1));
      update();
    });
    $("qtyPlus")?.addEventListener("click", () => {
      if (qtyInput) qtyInput.value = String(Math.min(100000, quantity() + 1));
      update();
    });

    // ---- gallery: a smooth scroll-snap strip. Thumbnails, swipes and linked variants all move the same strip. ----
    const track = $("galleryTrack");
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>(".thumb-btn"));
    const slides = Array.from(document.querySelectorAll<HTMLElement>(".gallery-slide"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function markActive(index: number) {
      thumbs.forEach((b, i) => b.classList.toggle("active", i === index));
      const t = thumbs[index];
      const strip = $("thumbStrip");
      if (t && strip && strip.scrollWidth > strip.clientWidth) {
        strip.scrollTo({ left: t.offsetLeft - strip.clientWidth / 2 + t.clientWidth / 2, behavior: reduceMotion ? "auto" : "smooth" });
      }
    }

    function goToSlide(index: number) {
      if (!track || index < 0 || index >= slides.length) return;
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft, behavior: reduceMotion ? "auto" : "smooth" });
      markActive(index);
    }

    // the photo linked to a chosen variant value slides into view; a value with no linked photo leaves the gallery alone
    function showVariantImage(url?: string) {
      if (!url) return;
      const index = slides.findIndex((s) => s.dataset.imageUrl === url);
      if (index >= 0) goToSlide(index);
    }

    thumbs.forEach((btn, i) => btn.addEventListener("click", () => goToSlide(i)));

    let scrollTimer: number | undefined;
    track?.addEventListener("scroll", () => {
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        if (!track) return;
        markActive(Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / Math.max(1, track.clientWidth)))));
      }, 60);
    }, { passive: true });

    track?.addEventListener("keydown", (e) => {
      const current = thumbs.findIndex((b) => b.classList.contains("active"));
      if (e.key === "ArrowRight") { e.preventDefault(); goToSlide(Math.min(slides.length - 1, current + 1)); }
      if (e.key === "ArrowLeft") { e.preventDefault(); goToSlide(Math.max(0, current - 1)); }
    });

    // Live minimum for the next shipment (the database counts what is already paid); the MOQ shown goes up to it
    (async () => {
      try {
        const cfg = JSON.parse(document.getElementById("lashtribe-config")?.textContent || "{}");
        if (!cfg.url || !cfg.key) return;
        const res = await fetch(cfg.url.replace(/\/$/, "") + "/rest/v1/rpc/product_shipment_min", {
          method: "POST",
          headers: { apikey: cfg.key, "Content-Type": "application/json" },
          body: JSON.stringify({ p_product: config.id }),
        });
        if (!res.ok) return;
        const data = await res.json();
        const n = Math.round(Number(data?.min_qty));
        if (!Number.isFinite(n) || n <= 1) return;
        minQty = n;
        if (n > config.moq) config.moq = n;
        if (qtyInput && quantity() < n) qtyInput.value = String(n);
        update();
      } catch (error) { /* page still works at its normal MOQ; checkout enforces the minimum */ }
    })();

    function openDrawer() {
      $("cartDrawer")?.classList.add("open");
      $("overlay")?.classList.add("open");
    }

    // Adds the chosen quantity + options. Returns false (and points at what is missing) when an option is not chosen.
    function addChosen(): boolean {
      const { complete, missing, chosen } = resolveOptions(config.options, selected);
      if (!complete) {
        missing.forEach((name: string) =>
          document.querySelector(`[data-option-group="${CSS.escape(name)}"]`)?.classList.add("option-missing")
        );
        if (optionMsg) {
          optionMsg.textContent = `Please choose ${missing.join(" and ")} first.`;
          optionMsg.hidden = false;
        }
        document.getElementById("optionGroups")?.scrollIntoView({ behavior: "smooth", block: "center" });
        return false;
      }
      cart()?.add(config.id, orderQuantity(), chosen);
      return true;
    }

    addButton?.addEventListener("click", () => {
      if (addChosen()) openDrawer();
    });

    $("buyNow")?.addEventListener("click", () => {
      if (!addChosen()) return;
      if (cart()) cart().goToCheckout();
      else window.location.href = "/ecommerce/checkout";
    });

    // "Goes together with": adds the product at its minimum order quantity
    document.querySelectorAll<HTMLButtonElement>("button.bundle-add").forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.productId;
        if (!id) return;
        button.classList.add("added");
        button.textContent = "✓";
        button.disabled = true;
        cart()?.add(id, Math.max(1, Number(button.dataset.moq) || 1));
        openDrawer();
      });
    });

    update();
  </script>
</Layout>
