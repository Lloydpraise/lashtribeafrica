---
import Layout from "../../../layouts/ecommerce/Layout.astro";
import SiteHeader from "../../../components/ecommerce/SiteHeader.astro";
import CartDrawer from "../../../components/ecommerce/CartDrawer.astro";
import SiteFooter from "../../../components/ecommerce/SiteFooter.astro";
import { getEcommerceProducts, formatKsh } from "../../../data/ecommerce-products.js";

export async function getStaticPaths() {
  const products = await getEcommerceProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
  }));
}

const allProducts = await getEcommerceProducts();
const slug = Astro.params.slug || allProducts[0].slug;
const product = allProducts.find((p) => p.slug === slug) || allProducts[0];
const complementaryProducts = allProducts.filter((item) =>
  product.complementSlugs.includes(item.slug)
);
const relatedProducts = allProducts.filter((item) => item.slug !== product.slug).slice(0, 3);
const priceDifference = product.marketPrice - product.nowPrice;
const coverImage = product.images?.[0];
---

<Layout title={`${product.name} | Lashtribe Africa`}>
  <SiteHeader />

  <main class="product-page">
    <section class="product-shell wrap">
      <div class="product-gallery">
        <div class="product-visual" id="productVisual">
          <span class="product-badge">{product.badge}</span>
          {product.hasOffer && <span class="offer-badge">{product.offerBadge}</span>}
          {coverImage ? (
            <img src={coverImage.url} alt={coverImage.alt || product.name} id="productMainImage" />
          ) : (
            <svg viewBox="0 0 100 100" set:html={product.icon} />
          )}
        </div>

        {product.images.length > 1 && (
          <div class="product-thumb-strip">
            {product.images.map((img, i) => (
              <button type="button" class:list={["thumb-btn", i === 0 && "active"]} data-image-url={img.url}>
                <img src={img.url} alt={img.alt || product.name} />
              </button>
            ))}
          </div>
        )}

        {product.videos.length > 0 && (
          <div class="product-video-block">
            <h3>Product Demo</h3>
            <video src={product.videos[0].url} controls preload="metadata" />
          </div>
        )}

        {complementaryProducts.length > 0 && (
          <div class="bundle-strip" aria-label="Goes together with">
            <div class="bundle-header">
              <span class="eyebrow">Goes together with</span>
            </div>
            <div class="bundle-items">
              {
                complementaryProducts.map((item) => (
                  <div class="bundle-card">
                    <div class="bundle-thumb">
                      {item.images?.[0] ? (
                        <img src={item.images[0].url} alt={item.name} />
                      ) : (
                        <svg viewBox="0 0 100 100" set:html={item.icon} />
                      )}
                    </div>
                    <div class="bundle-copy">
                      <strong>{item.name}</strong>
                      <span>{formatKsh(item.effectivePrice)}</span>
                    </div>
                    <button
                      class="bundle-add"
                      type="button"
                      data-product-id={item.id}
                      aria-label={`Add ${item.name} to cart`}
                    >
                      +
                    </button>
                  </div>
                ))
              }
            </div>
          </div>
        )}
      </div>

      <div class="product-panel">
        <div class="product-meta">
          <span class="eyebrow">
            {product.category ? product.category.name : "Wholesale favorite"}
          </span>
        </div>

        <h1>{product.name}</h1>

        {product.features.length > 0 && (
          <ul class="feature-list">
            {product.features.map((feature) => <li>{feature}</li>)}
          </ul>
        )}

        <div class="product-price-card">
          <div class="market-price-row">
            <span class="label">Market Price</span>
            <span class="market-price">{formatKsh(product.marketPrice)}</span>
          </div>
          <div class="save-row">
            <span class="label">You Will Save</span>
            <strong>{formatKsh(product.hasOffer ? product.marketPrice - product.effectivePrice : priceDifference)}</strong>
          </div>
          {product.hasOffer && (
            <div class="offer-price-row">
              <span class="offer-badge-inline">{product.offerBadge}</span>
              <span class="was-price">{formatKsh(product.nowPrice)}</span>
            </div>
          )}
          <div class="current-price-row">
            <span class="current-price">{formatKsh(product.effectivePrice)}</span>
          </div>
          <div class="moq-row">
            <span class="label">Minimum Order Qty</span>
            <span>{product.moq}</span>
          </div>
        </div>

        <div class="product-actions">
          <button class="btn-primary product-add" type="button" data-product-id={product.id}>
            Add to Cart
          </button>
          <button class="btn-black product-buy" type="button" data-product-id={product.id}>
            Buy Now
          </button>
        </div>

        <div class="product-description">
          <h2>Product Details</h2>
          <p>{product.description}</p>
          <p>
            Preorder from Lashtribe Africa and receive direct sourcing value on every order,
            with flexible batch volumes and fast dispatch on the next available production run.
          </p>
        </div>
      </div>
    </section>

    <section class="related-products wrap">
      <div class="section-head related-head">
        <h2>You may also like</h2>
      </div>
      <div class="related-grid">
        {
          relatedProducts.map((item) => (
            <a class="related-card" href={`/ecommerce/product/${item.slug}`}>
              <div class="related-thumb">
                {item.images?.[0] ? (
                  <img src={item.images[0].url} alt={item.name} />
                ) : (
                  <svg viewBox="0 0 100 100" set:html={item.icon} />
                )}
              </div>
              <div class="related-copy">
                <h3>{item.name}</h3>
                <div class="related-price-row">
                  <span class="market">{formatKsh(item.marketPrice)}</span>
                  <span class="now">{formatKsh(item.effectivePrice)}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <SiteFooter />
  <CartDrawer />

  <script src="/scripts/shared-cart.js" is:inline></script>
  <script src="/scripts/cart-render.js" is:inline></script>
  <script src="/scripts/main.js" is:inline></script>
  <script is:inline>
    (function () {
      const productIdAttr = document.querySelector('[data-product-id]')?.dataset.productId || '';
      const formatKsh = (value) => `Ksh ${Number(value || 0).toLocaleString()}`;

      // Gallery thumb switching
      document.querySelectorAll('.thumb-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const url = btn.dataset.imageUrl;
          const mainImg = document.getElementById('productMainImage');
          if (mainImg && url) mainImg.src = url;
          document.querySelectorAll('.thumb-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });

      function addToCart(id) {
        const cart = window.LashtribeCart ? window.LashtribeCart.getCart() : JSON.parse(localStorage.getItem('lashtribe_cart') || '{}');
        const next = { ...cart };
        next[id] = (Number(next[id]) || 0) + 1;

        if (window.LashtribeCart) {
          window.LashtribeCart.setCart(next);
          window.LashtribeCart.syncCartBadges();
        } else {
          localStorage.setItem('lashtribe_cart', JSON.stringify(next));
        }

        const drawer = document.getElementById('cartDrawer');
        if (drawer) {
          drawer.classList.add('open');
          const overlay = document.getElementById('overlay');
          if (overlay) overlay.classList.add('open');
        }
      }

      document.querySelectorAll('.product-add, .bundle-add').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.productId;
          if (!id) return;
          if (button.classList.contains('bundle-add')) {
            button.classList.add('added');
            button.textContent = '✓';
            button.disabled = true;
          }
          addToCart(id);
        });
      });

      document.querySelectorAll('.product-buy').forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.productId;
          if (!id) return;
          addToCart(id);
          if (window.LashtribeCart) {
            window.LashtribeCart.goToCheckout();
          } else {
            window.location.href = '/ecommerce/checkout';
          }
        });
      });
    })();
  </script>
</Layout>
