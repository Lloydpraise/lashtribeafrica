---
import Layout from "../../layouts/ecommerce/Layout.astro";
import AnnouncementTicker from "../../components/ecommerce/AnnouncementTicker.astro";
import SiteHeader from "../../components/ecommerce/SiteHeader.astro";
import Hero from "../../components/ecommerce/Hero.astro";
import MarketingPillars from "../../components/ecommerce/MarketingPillars.astro";
import ProductRail from "../../components/ecommerce/ProductRail.astro";
import KitStrip from "../../components/ecommerce/KitStrip.astro";
import AcademyHook from "../../components/ecommerce/AcademyHook.astro";
import RewardsReseller from "../../components/ecommerce/RewardsReseller.astro";
import SiteFooter from "../../components/ecommerce/SiteFooter.astro";
import CartDrawer from "../../components/ecommerce/CartDrawer.astro";
import { getEcommerceProducts, formatKsh } from "../../data/ecommerce-products.js";

const allProducts = await getEcommerceProducts();

function toRailCard(product) {
  return {
    slug: product.slug,
    icon: product.icon,
    image: product.images?.[0]?.url,
    name: product.name,
    marketPrice: formatKsh(product.marketPrice),
    nowPrice: formatKsh(product.nowPrice),
    note: product.note,
    moq: product.moq,
  };
}

const topSelling = allProducts
  .filter((p) => p.featuredSections.includes("top_selling"))
  .slice(0, 4)
  .map(toRailCard);

const newIn = allProducts
  .filter((p) => p.featuredSections.includes("new_in"))
  .slice(0, 4)
  .map(toRailCard);
---

<Layout>
  <AnnouncementTicker />
  <SiteHeader />
  <Hero />
  <MarketingPillars />
  {topSelling.length > 0 && (
    <ProductRail id="shop" title="Top Selling" products={topSelling} />
  )}
  {newIn.length > 0 && (
    <ProductRail id="new-in" title="New In" products={newIn} noTopPadding />
  )}
  <KitStrip />
  <AcademyHook />
  <RewardsReseller />
  <SiteFooter />
  <CartDrawer />

  <script src="/scripts/shared-cart.js" is:inline></script>
  <script src="/scripts/main.js" is:inline></script>
</Layout>
