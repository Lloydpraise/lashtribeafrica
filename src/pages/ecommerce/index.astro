---
import Layout from "../../layouts/ecommerce/Layout.astro";
import AnnouncementTicker from "../../components/ecommerce/AnnouncementTicker.astro";
import SiteHeader from "../../components/ecommerce/SiteHeader.astro";
import Hero from "../../components/ecommerce/Hero.astro";
import MarketingPillars from "../../components/ecommerce/MarketingPillars.astro";
import HowOrdering from "../../components/ecommerce/HowOrdering.astro";
import ProductRail from "../../components/ecommerce/ProductRail.astro";
import KitStrip from "../../components/ecommerce/KitStrip.astro";
import OfferCampaign from "../../components/ecommerce/OfferCampaign.astro";
import AcademyHook from "../../components/ecommerce/AcademyHook.astro";
import SiteFooter from "../../components/ecommerce/SiteFooter.astro";
import CartDrawer from "../../components/ecommerce/CartDrawer.astro";
import { getEcommerceProducts, cardPrices } from "../../data/ecommerce-products.js";
import { getActiveOffers, getCampaign } from "../../data/offers.js";

const allProducts = await getEcommerceProducts();

function toRailCard(product) {
  return {
    id: product.id,
    hasOptions: Boolean(product.hasOptions),
    slug: product.slug,
    icon: product.icon,
    image: product.images?.[0]?.url,
    name: product.name,
    ...cardPrices(product),
    hasOffer: product.hasOffer,
    offerBadge: product.offerBadge,
    campaignBadge: product.campaignBadge,
    dealNotes: product.dealNotes,
    note: product.note,
    description: product.description || "",
    moq: product.moq,
  };
}

const topSelling = allProducts
  .filter((p) => p.featuredSections.includes("top_selling"))
  .slice(0, 4)
  .map(toRailCard);

// Black Friday campaign: only exists while an offer of the campaign is live
const campaign = getCampaign(await getActiveOffers(), allProducts);
const campaignCards = campaign ? campaign.products.map(toRailCard) : [];

const newIn = allProducts
  .filter((p) => p.featuredSections.includes("new_in"))
  .slice(0, 4)
  .map(toRailCard);
---

<Layout>
  <AnnouncementTicker />
  <SiteHeader />
  <Hero />
  <MarketingPillars />
  <HowOrdering />
  {campaign && (
    <OfferCampaign title={campaign.title} bannerText={campaign.bannerText} products={campaignCards} />
  )}
  {topSelling.length > 0 && (
    <ProductRail id="shop" title="Top Selling" products={topSelling} />
  )}
  {newIn.length > 0 && (
    <ProductRail id="new-in" title="New In" products={newIn} noTopPadding />
  )}
  <KitStrip />
  <AcademyHook />
  <SiteFooter />
  <CartDrawer />

  <script src="/scripts/shared-cart.js" is:inline></script>
  <script src="/scripts/cart-render.js" is:inline></script>
  <script src="/scripts/main.js" is:inline></script>
</Layout>
