---
import Layout from "../layouts/ecommerce/Layout.astro";
---

<Layout title="Lashtribe Africa">
  <main class="landing-page">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-slide slide-closeup"></div>
    </div>
    <section class="landing-shell">
      <div class="brand-lockup" aria-label="Lashtribe Africa">
        <div class="logo">LASHTRIBE <em>Africa</em></div>
      </div>

      <p class="tagline">The one Place every lashtech in Africa should be!</p>

      <div class="landing-grid">
        <a class="landing-card" href="/ecommerce">
          <span class="kicker">Shop</span>
          <h2>Ecommerce</h2>
          <p>Browse products, cart, checkout, and wholesale offers.</p>
        </a>

        <a class="landing-card academy" href="/academy">
          <span class="kicker">Learn</span>
          <h2>Academy</h2>
          <p>Access lessons, dashboard, and training content.</p>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .landing-page {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.25rem;
    background: #0d0d0f;
    color: #1a1a1a;
    font-family: "Montserrat", sans-serif;
    overflow: hidden;
  }

  /* Our own lash close-up, slowly drifting. Overlay keeps text readable. */
  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    filter: brightness(0.8) saturate(0.9) contrast(1.05);
    animation: hero-drift 20s ease-in-out infinite alternate;
  }

  .slide-closeup {
    background-image: url("/landing/lash-closeup.webp");
    background-position: 58% 70%;
  }

  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(13, 13, 15, 0.38) 0%, rgba(13, 13, 15, 0.66) 75%),
      linear-gradient(180deg, rgba(13, 13, 15, 0.2) 0%, rgba(13, 13, 15, 0.75) 100%);
  }

  @keyframes hero-drift {
    from { transform: scale(1.04); }
    to { transform: scale(1.12); }
  }

  @media (max-width: 700px) {
    .slide-closeup { background-position: 60% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { animation: none; transform: scale(1.04); }
  }

  .landing-shell {
    position: relative;
    z-index: 1;
    width: min(980px, 100%);
    text-align: center;
    color: #fff;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .logo {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.8rem, 6vw, 7rem);
    letter-spacing: 0.02em;
    font-weight: 700;
    color: #fff;
    line-height: 0.95;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
  }

  .logo em {
    font-family: "Petit Formal Script", cursive;
    font-style: normal;
    font-weight: 400;
    font-size: 0.82em;
    padding: 0 0.05em;
    color: #f5d7d7;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);
  }

  .tagline {
    margin: 0 auto 2.25rem;
    max-width: 43rem;
    font-size: clamp(0.95rem, 2.2vw, 1.4rem);
    line-height: 1.5;
    letter-spacing: 0.02em;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }

  .landing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 1.25rem;
  }

  .landing-card {
    display: block;
    background: rgba(18, 18, 21, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 2rem 1.5rem;
    text-decoration: none;
    color: #f9f5f2;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .landing-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 42px rgba(0, 0, 0, 0.16);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .landing-card.academy {
    background: rgba(30, 18, 22, 0.8);
  }

  .kicker {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: #f2b5a0;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(1.5rem, 2vw, 2.2rem);
    font-family: "Playfair Display", serif;
    color: #fff;
  }

  p {
    margin: 0;
    line-height: 1.6;
    color: rgba(26, 26, 26, 0.8);
  }

  .landing-card p {
    color: rgba(255, 255, 255, 0.75);
  }

  @media (max-width: 768px) {
    .landing-page {
      padding: 1.5rem 1rem;
    }

    .brand-lockup {
      width: 100%;
      margin-bottom: 1rem;
    }

    .brand-lockup .logo {
      max-width: 100%;
      font-size: clamp(1.4rem, 7.5vw, 2.1rem);
      letter-spacing: 0;
      line-height: 1.1;
      white-space: nowrap;
    }

    .brand-lockup .logo em {
      font-size: 0.76em;
    }

    .tagline {
      margin-bottom: 1.5rem;
    }

    .landing-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.875rem;
    }
  }

  @media (hover: none) {
    .landing-card {
      transition: none;
    }

    .landing-card:hover {
      transform: none;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
      border-color: rgba(255, 255, 255, 0.12);
    }
  }
</style>
