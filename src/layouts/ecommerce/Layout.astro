---
import "../../styles/global.css";

interface Props {
  title?: string;
}

const {
  title = "Lashtribe Africa — Wholesale, Direct From Source",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('is-loading');
      window.addEventListener('load', () => {
        document.documentElement.classList.remove('is-loading');
      });
    </script>
    <style is:global>
      html.is-loading body {
        opacity: 0;
      }

      body {
        opacity: 1;
        transition: opacity 180ms ease;
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&family=Montserrat:wght@400;500;600;700&family=Petit+Formal+Script&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
