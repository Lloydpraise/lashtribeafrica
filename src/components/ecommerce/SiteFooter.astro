---
import { getSiteSettings, socialLinks } from "../../data/site-settings.js";

const { showAcademyStats = false } = Astro.props;
const settings = await getSiteSettings();
const socials = socialLinks(settings);

// Simple outline icons (24x24, stroke = currentColor).
const ICONS: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>',
  tiktok: '<path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>',
  facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  youtube: '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>',
};
---

<footer>
  <div class="wrap">
    {
      showAcademyStats && (
        <div class="foot-badges" id="academyStats" aria-label="Academy stats">
          <div class="foot-badge" data-stat="students" hidden>
            <span class="foot-badge-num" data-stat-value>0</span>
            <span class="foot-badge-label">Students taught</span>
          </div>
          <div class="foot-badge" data-stat="courses" hidden>
            <span class="foot-badge-num" data-stat-value>0</span>
            <span class="foot-badge-label">Courses</span>
          </div>
        </div>
      )
    }
    <div class="foot-top">
      <div>
        <div class="foot-logo">LASHTRIBE <em class="script">Africa</em></div>
        <p style="font-size:12px;color:#999;max-width:260px;line-height:1.6;">
          Wholesale, direct from source. No gatekeeping — just what we
          actually use.
        </p>
        {
          socials.length > 0 && (
            <ul class="foot-social" aria-label="Follow us">
              {socials.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener noreferrer" aria-label={l.label} title={l.label}>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.key]} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="foot-col">
        <h5>Shop</h5>
        <a href="/ecommerce">Ecommerce</a>
        <a href="/shop">All Products</a>
        <a href="/ecommerce#new-in">New In</a>
        <a href="/ecommerce#how-ordering">How Preorders Work</a>
      </div>
      <div class="foot-col">
        <h5>Learn</h5>
        <a href="/academy" class="academy-link">Lashtribe Academy →</a>
      </div>
      <div class="foot-col">
        <h5>Support</h5>
        <a href="/shipping-policy">Shipping & Preorders</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-and-conditions">Terms & Conditions</a>
        <a href="/contact">Contact Us</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Lashtribe Africa</span>
      <span>By the team behind Lashes By Shazz</span>
    </div>
  </div>
</footer>

<style>
  .foot-badge[hidden] {
    display: none;
  }
  .foot-social {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .foot-social a {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #e9e4e4;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .foot-social a:hover,
  .foot-social a:focus-visible {
    background: var(--warm-white);
    color: var(--black);
    border-color: var(--warm-white);
  }
</style>

<script>
  // Academy footer numbers come from the database. A number with no real source is simply not
  // shown (nothing is invented). Students need the optional 0012_public_stats.sql function:
  // without it only the course count appears.
  import { supabase } from "../../services/service.js";

  const wrap = document.getElementById("academyStats");
  const hasDatabase = Boolean(
    import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  );

  function show(key: string, value: unknown) {
    const badge = wrap?.querySelector<HTMLElement>(`[data-stat="${key}"]`);
    const n = Number(value);
    if (!badge || !Number.isFinite(n) || n <= 0) return;
    const num = badge.querySelector("[data-stat-value]");
    if (num) num.textContent = n.toLocaleString();
    badge.hidden = false;
  }

  async function loadStats() {
    let courses: number | null = null;
    let students: number | null = null;
    try {
      const { data, error } = await supabase.rpc("academy_public_stats");
      if (!error && data) {
        courses = data.courses ?? null;
        students = data.students ?? null;
      }
    } catch {
      /* function not installed: fall back below */
    }
    if (courses == null) {
      try {
        const { count } = await supabase
          .from("courses")
          .select("id", { count: "exact", head: true })
          .eq("status", "published");
        courses = count;
      } catch {
        /* leave hidden */
      }
    }
    show("courses", courses);
    show("students", students);
  }

  if (wrap && hasDatabase) void loadStats();
</script>
