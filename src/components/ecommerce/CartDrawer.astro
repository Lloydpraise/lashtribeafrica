---
import CartCatalogScript from "./CartCatalogScript.astro";
---

<CartCatalogScript />

<div class="overlay" id="overlay"></div>
<div class="drawer" id="cartDrawer">
  <div class="drawer-head">
    <h3>Your Preorder</h3>
    <button class="drawer-close" id="drawerClose">✕</button>
  </div>
  <div class="drawer-body">
    <div class="drawer-lines" id="drawerLines"></div>
    <p class="drawer-empty" id="drawerEmpty" hidden>
      Your cart is empty.<br /><a href="/ecommerce#shop">Browse products →</a>
    </p>

    <div class="savings-box">
      <div class="savings-row">
        <span>Market value</span><span id="marketTotal">Ksh 0</span>
      </div>
      <div class="savings-row saved">
        <span>You're saving</span><span id="savedTotal">Ksh 0</span>
      </div>
      <div class="savings-row total">
        <span>Total</span><span id="yourTotal">Ksh 0</span>
      </div>
    </div>
  </div>
  <div class="drawer-foot">
    <button class="btn-primary" id="drawerCheckoutBtn" type="button" style="width:100%;"
      >Checkout</button
    >
    <p class="note">
      Shipping fee confirmed separately, based on your delivery area. This
      is a preorder for the next scheduled batch. See our
      <a href="/shipping-policy">Shipping Policy</a>.
    </p>
  </div>
</div>
