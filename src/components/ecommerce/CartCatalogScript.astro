---
// Gives the cart scripts (cart-render.js) the public Supabase address so the cart can ask the database
// for its prices (the cart_quote function). It used to embed the WHOLE product catalog in every page that
// has a cart, which gets heavy with hundreds of products; now a page carries only these two public values
// and the cart fetches just the products that are actually in it.
// (Name kept so every page that already includes this component keeps working.)
const payload = {
  url: import.meta.env.PUBLIC_SUPABASE_URL || "",
  key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
};
---

<script type="application/json" id="lashtribe-config" set:html={JSON.stringify(payload)} />
