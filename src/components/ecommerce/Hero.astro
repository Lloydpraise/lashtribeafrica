---
import { getSiteSettings } from "../../data/site-settings.js";
import { fetchBatches, batchState, formatBatchDate, daysLabel } from "../../data/batches.js";

const settings = await getSiteSettings();
// Built into the page at deploy time; the script below refreshes it in the browser so the
// date and countdown are always current without a redeploy.
let batches = [];
try { batches = await fetchBatches(); } catch { /* falls back to the old texts */ }
const state = batchState(batches, settings.batchCutoffDays);
const countdown = state.next
  ? { label: daysLabel(state.daysLeft), percent: state.percent }
  : { label: "Next batch soon", percent: 0 };
const shipText = state.next ? `Next shipment ${formatBatchDate(state.next.ship_date)}` : settings.countdownOpenedText;
const assignedText = state.assigned ? `Order today → ships ${formatBatchDate(state.assigned.ship_date)}` : settings.countdownNextText;
const bgImageUrl = settings.heroBgImage?.url || null;
---

<section class="hero" id="home">
  <div class="hero-bg" aria-hidden="true">
    {bgImageUrl ? (
      <img class="hero-bg-photo" src={bgImageUrl} alt="" />
    ) : (
      <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M40 260 Q120 200 200 250 Q260 285 340 220"
          stroke="white"
          stroke-width="1"
          fill="none"
          opacity=".5"></path>
        <ellipse
          cx="220"
          cy="150"
          rx="90"
          ry="34"
          stroke="white"
          stroke-width="1"
          fill="none"
          opacity=".5"></ellipse>
        <path
          d="M60 300 Q200 340 340 290"
          stroke="white"
          stroke-width="1"
          fill="none"
          opacity=".35"></path>
      </svg>
    )}
    <div class="hero-overlay"></div>
    <div class="hero-photo-tag">{settings.heroPhotoTag}</div>
  </div>
  <div class="wrap hero-content">
    <div class="eyebrow hero-eyebrow">{settings.heroEyebrow}</div>
    <h1 class="hero-cycle-wrap">
      <span id="heroCycle" data-phrases={JSON.stringify(settings.heroPhrases)}>{settings.heroPhrases[0]}</span>
    </h1>
    <div class="hero-ctas">
      <a href={settings.heroCtaPrimaryLink} class="btn-primary">{settings.heroCtaPrimaryLabel}</a>
      <a href={settings.heroCtaSecondaryLink} class="btn-ghost">{settings.heroCtaSecondaryLabel}</a>
    </div>
    <div class="cadence">
      <div class="cadence-row">
        <span class="cadence-label">{settings.countdownLabel}</span>
        <span class="cadence-days" id="cadenceDays">{countdown.label}</span>
      </div>
      <div class="cadence-bar"><div class="cadence-fill" id="cadenceFill" style={`width:${countdown.percent}%;`}></div></div>
      <div class="cadence-foot">
        <span id="cadenceShip">{shipText}</span>
        <span id="cadenceAssigned">{assignedText}</span>
      </div>
    </div>
  </div>
</section>

<script>
  import { fetchBatches, fetchBatchCutoffDays, batchState, formatBatchDate, daysLabel } from "../../data/batches.js";

  async function refreshCadence() {
    try {
      const [batches, cutoff] = await Promise.all([fetchBatches(), fetchBatchCutoffDays()]);
      const state = batchState(batches, cutoff);
      if (!state.next) return;
      const set = (id: string, text: string) => {
        const el = document.getElementById(id);
        if (el) el.textContent = text;
      };
      set("cadenceDays", daysLabel(state.daysLeft ?? 0));
      set("cadenceShip", `Next shipment ${formatBatchDate(state.next.ship_date)}`);
      if (state.assigned) set("cadenceAssigned", `Order today → ships ${formatBatchDate(state.assigned.ship_date)}`);
      const fill = document.getElementById("cadenceFill");
      if (fill) fill.style.width = `${state.percent}%`;
    } catch {
      /* keep the server-rendered values */
    }
  }
  refreshCadence();
</script>
