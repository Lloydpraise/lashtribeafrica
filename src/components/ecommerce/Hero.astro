---
---

<section class="hero" id="home">
  <div class="hero-bg" aria-hidden="true">
    <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M40 260 Q120 200 200 250 Q260 285 340 220"
        stroke="white"
        stroke-width="1"
        fill="none"
        opacity=".5"></path>
      <ellipse
        cx="220"
        cy="150"
        rx="90"
        ry="34"
        stroke="white"
        stroke-width="1"
        fill="none"
        opacity=".5"></ellipse>
      <path
        d="M60 300 Q200 340 340 290"
        stroke="white"
        stroke-width="1"
        fill="none"
        opacity=".35"></path>
    </svg>
    <div class="hero-overlay"></div>
    <div class="hero-photo-tag">Studio Lash Bed — Nairobi</div>
  </div>
  <div class="wrap hero-content">
    <div class="eyebrow hero-eyebrow">Wholesale For Lashtechs</div>
    <h1 class="hero-cycle-wrap"><span id="heroCycle">Direct Sourcing.</span></h1>
    <div class="hero-ctas">
      <a href="#shop" class="btn-primary">Order Now</a>
      <a href="#how-it-works" class="btn-ghost">How It Works</a>
    </div>
    <div class="cadence">
      <div class="cadence-row">
        <span class="cadence-label">Order Now</span>
        <span class="cadence-days" id="cadenceDays">5 days left</span>
      </div>
      <div class="cadence-bar"><div class="cadence-fill" id="cadenceFill"></div></div>
      <div class="cadence-foot">
        <span>Window opened Mon</span>
        <span>Next batch ships soon</span>
      </div>
    </div>
  </div>
</section>
