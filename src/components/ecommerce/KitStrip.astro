---
import { getEcommerceProducts, formatKsh } from "../../data/ecommerce-products.js";
import { getActiveKit, resolveKitProducts, slugifyKitTitle } from "../../data/kits.js";

const [allProducts, activeKit] = await Promise.all([getEcommerceProducts(), getActiveKit()]);
const kitProducts = resolveKitProducts(activeKit, allProducts);
const kitSavings = kitProducts.reduce(
  (total, product) =>
    total +
    Math.max(0, product.marketPrice - product.effectivePrice) *
      Math.max(1, Number(product.moq) || 1),
  0
);

// Fallback copy — what used to be hardcoded here — shown until a kit is
// created and set active in the admin panel.
const title = activeKit?.title || "The starter set every lashtech reaches for.";
const eyebrow = activeKit?.eyebrow || "You Should Have";
const description =
  activeKit?.description ||
  "Four essentials, bundled at MOQ, chosen from what actually moves through our own studio every week.";
const ctaLabel = activeKit?.ctaLabel || "Shop The Set";
const ctaLink = activeKit ? `/kit/${slugifyKitTitle(activeKit.title)}` : "/shop";
---

<section class="shop wrap">
  <div class="kit-strip reveal">
    <div class="kit-copy">
      <div class="eyebrow">{eyebrow}</div>
      <h3>{title}</h3>
      <p>{description}</p>
      <a
        href={ctaLink}
        class="btn-primary"
        style="display:inline-block;margin-top:6px;background:var(--black);color:var(--warm-white);border-color:var(--black);"
        >{ctaLabel}</a
      >
    </div>
    <div class="kit-showcase">
      <div class="kit-items">
        {kitProducts.length > 0 ? (
          kitProducts.map((product) => (
            <a class="kit-item kit-item-product" href={`/ecommerce/product/${product.slug}`} title={product.name}>
              {product.images?.[0]?.url ? (
                <img src={product.images[0].url} alt={product.name} loading="lazy" />
              ) : (
                <svg viewBox="0 0 60 60" set:html={product.icon} />
              )}
              <span class="kit-item-price">{formatKsh(product.effectivePrice)}</span>
            </a>
          ))
        ) : (
          <>
            <div class="kit-item">
              <svg viewBox="0 0 60 60"
                ><path
                  d="M8 40 Q30 20 52 35"
                  stroke="black"
                  stroke-width="1.3"
                  fill="none"></path></svg
              >
            </div>
            <div class="kit-item">
              <svg viewBox="0 0 60 60"
                ><ellipse
                  cx="30"
                  cy="30"
                  rx="18"
                  ry="8"
                  stroke="black"
                  stroke-width="1.3"
                  fill="none"></ellipse></svg
              >
            </div>
            <div class="kit-item">
              <svg viewBox="0 0 60 60"
                ><path
                  d="M15 15 L45 45 M45 15 L15 45"
                  stroke="black"
                  stroke-width="1.3"></path></svg
              >
            </div>
          </>
        )}
      </div>
      {kitProducts.length > 0 && (
        <p class="kit-savings">Save {formatKsh(kitSavings)} on Set!</p>
      )}
    </div>
  </div>
</section>

<style>
  .kit-showcase {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .kit-items {
    display: flex;
    gap: 14px;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: rgba(17, 17, 17, .2) transparent;
  }

  .kit-showcase::before {
    position: absolute;
    inset: 0 auto 0 0;
    left: 0;
    z-index: 2;
    width: 34px;
    content: "";
    pointer-events: none;
    background: linear-gradient(90deg, var(--blush), rgba(243, 228, 231, 0));
  }

  .kit-item {
    flex: 0 0 calc((100% - 42px) / 4);
    min-width: 0;
    scroll-snap-align: start;
  }

  .kit-item-product {
    aspect-ratio: 1 / 1.1;
  }

  .kit-savings {
    margin: 12px 0 0;
    color: #287a46;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  @media (max-width: 880px) {
    .kit-item {
      flex-basis: calc((100% - 14px) / 2);
    }
  }
</style>
