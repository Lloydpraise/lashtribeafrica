---
import ProductCard from "./ProductCard.astro";

interface Product {
  id?: string;
  hasOptions?: boolean; // products with variants send the customer to the product page to choose
  strikePrice?: string; // crossed-out price ("" = none)
  price?: string; // the price actually paid
  saveText?: string; // "Save Ksh 500" ("" = no save line)
  slug?: string;
  icon?: string; // inner SVG markup for the product illustration (fallback when no photo)
  image?: string; // cover photo URL, preferred over icon when present
  name: string;
  description?: string;
  nowPrice?: string;
  hasOffer?: boolean;
  offerBadge?: string; // e.g. "20% OFF"
  campaignBadge?: string; // "BLACK FRIDAY DEAL" (black strip, top right)
  dealNotes?: string[]; // ["Order from 2", "Free shipping"]
  moq?: number;
  searchText?: string;
}

interface Props {
  id?: string;
  title: string;
  viewAllHref?: string;
  products: Product[];
  noTopPadding?: boolean;
  showViewAll?: boolean;
  eagerCount?: number; // first N card photos load immediately (above the fold); the rest are lazy
}

const {
  id,
  title,
  viewAllHref = "/shop",
  products,
  noTopPadding = false,
  showViewAll = true,
  eagerCount = 0,
} = Astro.props;

const delayClasses = ["", "d1", "d2", "d3"];
---

<section
  class="shop wrap"
  id={id}
  data-product-section
  style={noTopPadding ? "padding-top:0;" : undefined}
>
  <div class="section-head reveal">
    <h2>{title}</h2>
    {showViewAll && <a class="view-all" href={viewAllHref}>View All Products</a>}
  </div>
  <div class="rail">
    {
      products.map((product, i) => (
        <ProductCard product={product} eager={i < eagerCount} delay={delayClasses[i % delayClasses.length]} />
      ))
    }
  </div>
</section>
