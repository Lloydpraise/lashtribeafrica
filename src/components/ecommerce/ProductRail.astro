---
interface Product {
  slug?: string;
  icon?: string; // inner SVG markup for the product illustration (fallback when no photo)
  image?: string; // cover photo URL, preferred over icon when present
  name: string;
  marketPrice: string;
  nowPrice: string;
  offerPrice?: string; // offer-adjusted price, when hasOffer is true
  hasOffer?: boolean;
  offerBadge?: string; // e.g. "20% OFF"
  note: string;
  moq?: number;
  searchText?: string;
}

interface Props {
  id?: string;
  title: string;
  viewAllHref?: string;
  products: Product[];
  noTopPadding?: boolean;
  showViewAll?: boolean;
}

const {
  id,
  title,
  viewAllHref = "/shop",
  products,
  noTopPadding = false,
  showViewAll = true,
} = Astro.props;

const delayClasses = ["", "d1", "d2", "d3"];
---

<section
  class="shop wrap"
  id={id}
  data-product-section
  style={noTopPadding ? "padding-top:0;" : undefined}
>
  <div class="section-head reveal">
    <h2>{title}</h2>
    {showViewAll && <a class="view-all" href={viewAllHref}>View All Products</a>}
  </div>
  <div class="rail">
    {
      products.map((product, i) => (
        <article class:list={["card", "reveal", delayClasses[i % delayClasses.length]]} data-product-search={product.searchText ?? product.name}>
          <a class="card-link" href={product.slug ? `/ecommerce/product/${product.slug}` : "/ecommerce/product/0-07-volume-fans-mixed-tray"}>
            <div class="card-img">
              <div class="card-badges">
                {product.hasOffer && <span class="badge-offer">{product.offerBadge}</span>}
                <span class="badge-moq">MOQ {product.moq ?? 5}</span>
              </div>
              {product.image ? (
                <img src={product.image} alt={product.name} loading="lazy" />
              ) : (
                <svg viewBox="0 0 100 100" set:html={product.icon} />
              )}
            </div>
            <div class="card-body">
              <h4>{product.name}</h4>
              <div class="price-row">
                {product.hasOffer ? (
                  <>
                    <span class="price-market price-was">{product.nowPrice}</span>
                    <span class="price-now price-offer">{product.offerPrice}</span>
                  </>
                ) : (
                  <>
                    <span class="price-market">{product.marketPrice}</span>
                    <span class="price-now">{product.nowPrice}</span>
                  </>
                )}
              </div>
              <div class="card-note">{product.note}</div>
            </div>
          </a>
        </article>
      ))
    }
  </div>
</section>
