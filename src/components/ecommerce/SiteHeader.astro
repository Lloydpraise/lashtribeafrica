---
import MobileNav from "./MobileNav.astro";
---

<header id="siteHeader">
  <div class="wrap nav-row">
    <div class="logo">LASHTRIBE <em>Africa</em></div>
    <MobileNav />
    <div class="header-actions">
      <button class="icon-btn" id="searchToggle" aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
          ><circle cx="7" cy="7" r="5.2" stroke="black" stroke-width="1.3"
          ></circle><path d="M11 11 L15 15" stroke="black" stroke-width="1.3"
          ></path></svg
        >
      </button>
      <button class="cart-btn" id="cartOpen" aria-label="Open cart">
        <svg class="cart-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true"
          ><path d="M3 4.5h2.1l1.4 7.1h8.7l1.5-5.9H6.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          ><circle cx="8.2" cy="15.4" r="1.2" fill="currentColor"></circle><circle cx="14.6" cy="15.4" r="1.2" fill="currentColor"></circle></svg
        >
        <span class="cart-label">Cart</span>
        <span class="cart-count" id="cartCount">10</span>
      </button>
      <button class="burger" id="burgerBtn" aria-label="Menu">
        <svg width="22" height="16" viewBox="0 0 22 16"
          ><path d="M0 1h22M0 8h22M0 15h22" stroke="black" stroke-width="1.4"
          ></path></svg
        >
      </button>
    </div>
  </div>
  <div class="search-panel" id="searchPanel">
    <div class="wrap search-inner">
      <input
        type="text"
        placeholder="Search adhesives, fans, tools, tweezers…"
        id="searchInput"
      />
      <button>Search</button>
    </div>
  </div>
</header>
