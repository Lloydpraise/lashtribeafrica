---
---

<div class="checkout-modal" id="checkoutModal">
  <div class="checkout-head">
    <h3>Buy Course</h3>
    <button class="checkout-close" id="checkoutClose">✕</button>
  </div>
  <div class="checkout-body">
    <div class="co-course">
      <div class="module-cover" style="width:76px;height:76px;">
        <svg viewBox="0 0 100 100"
          ><path
            d="M20 30 L80 30 M20 50 L80 50 M20 70 L60 70"
            stroke="black"
            stroke-width="1.5"></path></svg
        >
      </div>
      <div>
        <h5 id="coCourseTitle">Lash Business Bootcamp</h5>
        <span id="coCoursePrice">Ksh 4,500</span>
      </div>
    </div>
    <ul class="co-includes">
      <li>Lifetime access to this course</li>
      <li>Certificate on completion</li>
      <li>Access on any device</li>
    </ul>
  </div>
  <div class="checkout-foot">
    <div class="pay-row"><span>Total to pay</span><span id="coTotal">Ksh 4,500</span></div>
    <button class="btn-primary" id="payCourseBtn" style="width:100%;">Pay Here</button>
  </div>
</div>
