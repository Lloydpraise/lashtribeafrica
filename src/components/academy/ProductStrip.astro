---
// "Products used in this course": the first few real shop products (live catalog), so names,
// prices, photos and minimum order quantities always match the shop.
import { getEcommerceProducts, formatKsh } from "../../data/ecommerce-products.js";

const products = (await getEcommerceProducts()).slice(0, 3);
---

{
  products.length > 0 && (
    <div class="product-strip">
      <div class="eyebrow">Products Used In This Course</div>
      <div class="product-strip-row">
        {products.map((p) => (
          <div class="ps-card">
            <div class="ps-thumb">
              {p.images?.[0]?.url ? (
                <img src={p.images[0].url} alt="" loading="lazy" decoding="async" />
              ) : (
                <svg viewBox="0 0 60 60" set:html={p.icon} />
              )}
            </div>
            <div class="ps-info">
              <h6>{p.name}</h6>
              <span>{p.priceVaries ? "From " : ""}{formatKsh(p.effectiveFromPrice ?? p.effectivePrice ?? p.nowPrice)}</span>
            </div>
            {p.hasOptions ? (
              <a class="ps-add ps-choose" href={`/ecommerce/product/${p.slug}`} aria-label={`Choose options for ${p.name}`}>›</a>
            ) : (
              <button class="ps-add" data-id={p.id} data-name={p.name} data-moq={p.moq}>+</button>
            )}
          </div>
        ))}
      </div>
    </div>
  )
}
