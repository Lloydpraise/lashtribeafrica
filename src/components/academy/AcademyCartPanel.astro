---
// The academy cart is the SAME cart as the shop (localStorage "lashtribe_cart", keyed by
// product id). Lines, prices and totals are drawn from the live catalog embedded below by
// /scripts/cart-render.js, so nothing here is hardcoded.
import CartCatalogScript from "../ecommerce/CartCatalogScript.astro";
---

<CartCatalogScript />

<div class="academy-cart-overlay" id="academyCartOverlay"></div>
<div class="academy-cart-drawer" id="academyCartDrawer" role="dialog" aria-label="Your cart" aria-modal="true">
  <div class="academy-cart-head">
    <h3>Your cart</h3>
    <button class="academy-cart-close" id="academyCartClose" type="button" aria-label="Close cart">✕</button>
  </div>

  <div class="academy-cart-body">
    <div class="drawer-lines" id="drawerLines"></div>
    <p class="drawer-empty" id="drawerEmpty" hidden>
      Your cart is empty.<br /><a href="/shop">Browse products →</a>
    </p>

    <div class="academy-cart-summary">
      <div class="academy-cart-row"><span>Market value</span><strong id="marketTotal">Ksh 0</strong></div>
      <div class="academy-cart-row saved"><span>You save</span><strong id="savedTotal">Ksh 0</strong></div>
      <div class="academy-cart-row total"><span>Total</span><strong id="yourTotal">Ksh 0</strong></div>
    </div>
  </div>

  <div class="academy-cart-foot">
    <button class="btn-primary" id="academyCartCheckout" type="button">Checkout</button>
  </div>
</div>
