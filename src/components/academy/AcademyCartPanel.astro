---
---

<div class="academy-cart-overlay" id="academyCartOverlay"></div>
<div class="academy-cart-drawer" id="academyCartDrawer">
  <div class="academy-cart-head">
    <h3>Your cart</h3>
    <button class="academy-cart-close" id="academyCartClose" type="button">✕</button>
  </div>

  <div class="academy-cart-body">
    <div class="academy-cart-line">
      <div class="academy-cart-thumb">
        <svg viewBox="0 0 60 60"><path d="M8 40 Q30 20 52 35" stroke="black" stroke-width="1.2" fill="none"></path></svg>
      </div>
      <div class="academy-cart-line-info">
        <h5>0.07 Volume Fans</h5>
        <div class="academy-cart-meta">MOQ 5 · Ksh 1,150 each</div>
        <div class="stepper">
          <button class="qty-btn academy-qty-btn" data-line="1" data-dir="-1" type="button">–</button>
          <span class="qty-val" id="academyQty1">5</span>
          <button class="qty-btn academy-qty-btn" data-line="1" data-dir="1" type="button">+</button>
        </div>
      </div>
      <div class="academy-cart-line-price" id="academyLineTotal1">Ksh 5,750</div>
    </div>

    <div class="academy-cart-line">
      <div class="academy-cart-thumb">
        <svg viewBox="0 0 60 60"><ellipse cx="30" cy="30" rx="18" ry="8" stroke="black" stroke-width="1.2" fill="none"></ellipse></svg>
      </div>
      <div class="academy-cart-line-info">
        <h5>Pro Bond Adhesive</h5>
        <div class="academy-cart-meta">MOQ 5 · Ksh 1,600 each</div>
        <div class="stepper">
          <button class="qty-btn academy-qty-btn" data-line="2" data-dir="-1" type="button">–</button>
          <span class="qty-val" id="academyQty2">5</span>
          <button class="qty-btn academy-qty-btn" data-line="2" data-dir="1" type="button">+</button>
        </div>
      </div>
      <div class="academy-cart-line-price" id="academyLineTotal2">Ksh 8,000</div>
    </div>

    <div class="academy-cart-summary">
      <div class="academy-cart-row"><span>Market value</span><strong id="academyMarketTotal">Ksh 21,000</strong></div>
      <div class="academy-cart-row saved"><span>You save</span><strong id="academySavedTotal">Ksh 7,250</strong></div>
      <div class="academy-cart-row total"><span>Total</span><strong id="academyYourTotal">Ksh 13,750</strong></div>
    </div>
  </div>

  <div class="academy-cart-foot">
    <button class="btn-primary" id="academyCartCheckout" type="button">Checkout</button>
  </div>
</div>
