---
import CourseCard from "./CourseCard.astro";
import AdvancedCourseCard from "./AdvancedCourseCard.astro";
import NextModuleCard from "./NextModuleCard.astro";

const moreCourses = [
  {
    icon: '<ellipse cx="50" cy="50" rx="30" ry="12" stroke="black" stroke-width="1.5" fill="none"/>',
    title: "Classic Set Essentials",
    blurb: "The foundation every lashtech starts with.",
  },
  {
    icon: '<path d="M15 55 Q50 30 85 55" stroke="black" stroke-width="1.5" fill="none"/>',
    title: "Volume Lashing Fundamentals",
    blurb: "Start here — fans, isolation, and the basics.",
  },
  {
    icon: '<path d="M20 50 L80 50 M50 20 L50 80" stroke="black" stroke-width="1.5"/>',
    title: "Tool & Product Handling",
    blurb: "Adhesive, tweezers, and hygiene basics.",
  },
  {
    icon: '<rect x="25" y="25" width="50" height="50" stroke="black" stroke-width="1.5" fill="none"/>',
    title: "Client Consultations",
    blurb: "Reading face shape and setting expectations.",
  },
  {
    icon: '<path d="M10 60 Q35 40 60 55 Q80 68 95 45" stroke="black" stroke-width="1.5" fill="none"/>',
    title: "Aftercare & Retention",
    blurb: "Keeping clients coming back for refills.",
  },
];

const advancedCourses = [
  {
    id: "bootcamp",
    icon: '<path d="M20 30 L80 30 M20 50 L80 50 M20 70 L60 70" stroke="black" stroke-width="1.5"/>',
    title: "Lash Business Bootcamp",
    blurb: "Pricing, marketing, and running a lash studio that actually pays.",
    price: 4500,
  },
  {
    id: "russian",
    icon: '<path d="M20 60 Q40 20 60 60 Q70 40 85 60" stroke="black" stroke-width="1.5" fill="none"/>',
    title: "Russian Volume Pro",
    blurb: "Advanced fan shaping and symmetry for dense, lightweight volume.",
    price: 3200,
  },
];
---

<div id="dashboardPopulated" class="wrap dash-wrap">
  <div class="continue-hero reveal" data-course="classic-set-essentials">
    <div class="continue-bg">
      <img class="continue-hero-image" id="continueHeroImage" alt="" aria-hidden="true" hidden />
    </div>
    <div class="continue-overlay"></div>
    <div class="continue-content">
      <div class="eyebrow">Continue Learning</div>
      <h1 id="continueCourseTitle">Classic Set Essentials</h1>
      <p class="continue-sub" id="continueCourseSub">Continue where you left off.</p>
      <div class="progress-row">
        <div class="progress-bar" role="progressbar" aria-label="Course progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div class="progress-fill" id="continueProgressFill" style="width:0%;"></div></div>
        <span id="continueProgressLabel">0%</span>
      </div>
      <button class="play-btn" id="continuePlayBtn"><span class="play-circle">▶</span> Continue Course</button>
    </div>
  </div>

  <div class="section-head reveal"><h2>Your Next Module</h2></div>
  <div class="course-grid reveal" id="courseGridPopulated">
    {moreCourses.map((c) => <CourseCard icon={c.icon} title={c.title} blurb={c.blurb} />)}
  </div>

  <div class="section-head reveal"><h2>More Courses</h2></div>
  <div class="module-row reveal">
    <NextModuleCard />
  </div>

  <div class="section-head adv-head reveal">
    <h2>Advanced Courses</h2><span class="eyebrow">Members-only pricing</span>
  </div>
  <div class="course-grid advanced-grid reveal" id="advancedGridPopulated">
    {
      advancedCourses.map((c) => (
        <AdvancedCourseCard id={c.id} icon={c.icon} title={c.title} blurb={c.blurb} price={c.price} />
      ))
    }
  </div>
</div>
