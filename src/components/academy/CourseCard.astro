---
interface Props {
  icon: string; // inner SVG markup for the module cover illustration
  title: string;
  blurb: string;
}

const { icon, title, blurb } = Astro.props;

// Maps a dashboard card to its course slug in the academy (see /academy/learn).
const SLUGS: Record<string, string> = {
  "Tool & Product Handling": "tool-and-product-handling",
};
const slug =
  SLUGS[title] ??
  title.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
---

<div class="course-card" data-open-player="1" data-course={slug}>
  <div class="module-cover">
    <svg viewBox="0 0 100 100" set:html={icon} />
  </div>
  <div class="course-body">
    <h4>{title}</h4>
    <p>{blurb}</p>
    <div class="course-cta-row">
      <span class="course-free-tag">Included</span>
      <button class="course-start" data-open-player="1" data-course={slug}>Start Course →</button>
    </div>
  </div>
</div>
