---
---

<header class="app-header">
  <div class="wrap app-header-row">
    <div class="logo">LASHTRIBE <em>Academy</em></div>
    <div class="header-actions">
      <button class="cart-mini" id="cartMiniBtn" aria-label="Cart">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
          ><path
            d="M1 1h2l1.6 8.6a1.5 1.5 0 0 0 1.5 1.2h6a1.5 1.5 0 0 0 1.47-1.2L15 4H4"
            stroke="black"
            stroke-width="1.2"></path><circle cx="6" cy="14" r="1" fill="black"
          ></circle><circle cx="12" cy="14" r="1" fill="black"></circle></svg
        >
        <span class="cart-mini-badge" id="cartMiniBadge">0</span>
      </button>
      <div class="account-wrap">
        <button class="account-btn" id="accountBtn">
          <span class="avatar" id="avatarInitial">A</span>
          <span class="account-name" id="accountNameLabel">Amina</span>
          <svg width="10" height="6" viewBox="0 0 10 6"
            ><path d="M1 1 L5 5 L9 1" stroke="black" stroke-width="1.4" fill="none"
            ></path></svg
          >
        </button>
        <div class="account-menu" id="accountMenu">
          <a href="#">My Courses</a>
          <a href="#">Certificates</a>
          <a href="#" id="signOutBtn">Sign Out</a>
        </div>
      </div>
    </div>
  </div>
</header>
